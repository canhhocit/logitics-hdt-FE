# ==========================================
# CẤU HÌNH API ENDPOINT CHO FRONTEND (Next.js)
# ==========================================

# URL API gọi từ Client-side (Trình duyệt của người dùng tải về)
# Khi deploy lên hosting (Vercel/Netlify), đổi thành domain thật (vd: https://api.hdtlogistics.vn/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# URL API gọi từ Server-side (SSR/SSG của Next.js khi render server)
# Thường trỏ thẳng vào tên container backend nếu dùng chung mạng Docker (vd: http://backend:8080/api/v1)
# Nếu chỉ chạy dev local bình thường thì để giống NEXT_PUBLIC_API_URL
INTERNAL_API_URL=http://localhost:8080/api/v1
